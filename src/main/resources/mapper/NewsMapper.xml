<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edu.news.mapper.NewsMapper">

    <!-- 结果映射：关联分类名、作者昵称 -->
    <resultMap id="newsResultMap" type="com.edu.news.entity.News">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="cover" column="cover"/>
        <result property="categoryId" column="category_id"/>
        <result property="authorId" column="author_id"/>
        <result property="status" column="status"/>
        <result property="viewCount" column="view_count"/>
        <result property="isTop" column="is_top"/>
        <result property="publishTime" column="publish_time"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="categoryName" column="category_name"/>
        <result property="authorName" column="author_name"/>
    </resultMap>

    <!-- 公共查询列 -->
    <sql id="baseColumns">
        n.id, n.title, n.content, n.cover, n.category_id, n.author_id, n.status,
        n.view_count, n.is_top, n.publish_time, n.create_time, n.update_time,
        c.name AS category_name,
        IFNULL(u.nickname, u.username) AS author_name
    </sql>

    <!--
      多条件联表分页查询（MyBatis 动态 SQL：<where> / <if> / <include>）
      条件均可为空，为空时自动忽略，由 MyBatis-Plus 分页插件自动分页。
    -->
    <select id="selectNewsPage" resultMap="newsResultMap">
        SELECT
        <include refid="baseColumns"/>
        FROM tb_news n
        LEFT JOIN tb_category c ON n.category_id = c.id
        LEFT JOIN tb_user u ON n.author_id = u.id
        <where>
            <if test="q.keyword != null and q.keyword != ''">
                AND n.title LIKE CONCAT('%', #{q.keyword}, '%')
            </if>
            <if test="q.categoryId != null">
                AND n.category_id = #{q.categoryId}
            </if>
            <if test="q.status != null">
                AND n.status = #{q.status}
            </if>
            <if test="q.isTop != null">
                AND n.is_top = #{q.isTop}
            </if>
            <if test="q.authorId != null">
                AND n.author_id = #{q.authorId}
            </if>
        </where>
        ORDER BY n.is_top DESC, n.create_time DESC
    </select>

    <!-- 资讯详情（联表带出分类名、作者昵称） -->
    <select id="selectNewsDetail" resultMap="newsResultMap">
        SELECT
        <include refid="baseColumns"/>
        FROM tb_news n
        LEFT JOIN tb_category c ON n.category_id = c.id
        LEFT JOIN tb_user u ON n.author_id = u.id
        WHERE n.id = #{id}
    </select>

</mapper>
